// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth) adapter models ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Only set for credentials sign-up; null for OAuth-only users.
  password      String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  fplTeams FplTeam[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App domain models ---
// Scope: users, squads, transfer history (build step 1). Fixtures, advanced
// stats, chip usage, and planning tables are added in later build steps.

model FplTeam {
  id          String   @id @default(cuid())
  userId      String
  fplTeamId   Int
  teamName    String?
  managerName String?
  linkedAt    DateTime @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots   SquadSnapshot[]
  transfers   TransferHistory[]
  lineupPlans LineupPlan[]
  chipUsages  ChipUsage[]

  @@unique([userId, fplTeamId])
}

// A season's rules — kept as data since free-transfer caps, rollover limits,
// and the chip set have changed between FPL seasons.
model Season {
  id                        String   @id @default(cuid())
  label                     String   @unique // e.g. "2026/27"
  isCurrent                 Boolean  @default(false)
  freeTransferCap           Int
  freeTransferRolloverLimit Int
  chipsAvailable            String[] // e.g. ["wildcard", "free_hit", "bench_boost", "triple_captain"]

  gameweeks   Gameweek[]
  chipWindows ChipWindow[]
}

// One usable window per chip instance — real FPL gives each chip two
// separate windows (first half/second half of the season), each usable
// exactly once; an unused window doesn't roll into the next one, it's just
// lost once its stopEvent gameweek has passed. Pulled directly from the FPL
// bootstrap API's "chips" list (one entry per window, each with its own
// start_event/stop_event) rather than assumed — the boundary between
// windows isn't a fixed gameweek number season to season.
model ChipWindow {
  id         String @id @default(cuid())
  seasonId   String
  chip       String
  startEvent Int
  stopEvent  Int

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, chip, startEvent])
}

model Gameweek {
  id           String   @id @default(cuid())
  seasonId     String
  number       Int
  deadlineTime DateTime
  isCurrent    Boolean  @default(false)
  isNext       Boolean  @default(false)
  isFinished   Boolean  @default(false)

  season      Season            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  snapshots   SquadSnapshot[]
  transfers   TransferHistory[]
  lineupPlans LineupPlan[]
  chipUsages  ChipUsage[]
  fixtures    Fixture[]

  @@unique([seasonId, number])
}

model Club {
  id        Int    @id // official FPL club id
  code      Int? // official FPL team code — used to build shirt image URLs, distinct from id
  name      String
  shortName String

  players      Player[]
  homeFixtures Fixture[] @relation("FixtureHomeTeam")
  awayFixtures Fixture[] @relation("FixtureAwayTeam")
}

// The season's full fixture list (every gameweek, not just the current
// one) — shared reference data, refreshed the same opportunistic way as
// clubs/players: re-upserted on every import, not on a schedule. Used to
// show each squad player's opponent for the gameweek being viewed instead
// of just their own club.
model Fixture {
  id         Int    @id // official FPL fixture id
  gameweekId String
  homeTeamId Int
  awayTeamId Int

  gameweek Gameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  homeTeam Club     @relation("FixtureHomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Club     @relation("FixtureAwayTeam", fields: [awayTeamId], references: [id])

  @@index([gameweekId])
}

enum Position {
  GK
  DEF
  MID
  FWD
}

model Player {
  id           Int      @id // official FPL element id
  clubId       Int
  webName      String
  fullName     String
  position     Position
  currentPrice Int // in tenths of a million, matching the FPL API (e.g. 105 = £10.5m)
  status       String   @default("available")

  // Fantasy-relevance fields for the player profile card — all straight
  // from the FPL bootstrap API's per-element stats, refreshed on every
  // import the same way price/status are. See squad.py's PlayerProfileOut
  // for what each is used for.
  photoCode                Int? // numeric prefix of the API's "photo" filename (e.g. "154561.jpg" -> 154561) — builds the portrait URL, see squad.py
  form                     Float  @default(0) // FPL's own rolling recent-form average
  totalPoints              Int    @default(0)
  pointsPerGame            Float  @default(0)
  selectedByPercent        Float  @default(0) // ownership — ties to how "template" a pick is
  minutes                  Int    @default(0) // playing-time / rotation-risk signal
  goalsScored              Int    @default(0)
  assists                  Int    @default(0)
  cleanSheets              Int    @default(0)
  bonus                    Int    @default(0)
  ictIndex                 Float  @default(0) // FPL's own Influence/Creativity/Threat composite
  expectedGoals            Float  @default(0)
  expectedAssists          Float  @default(0)
  valueSeason              Float  @default(0) // total points per £1m — FPL's own "value" metric
  chanceOfPlayingNextRound Int? // 0-100, null means "no doubt" (fully fit)
  news                     String @default("") // injury/suspension/rotation note, empty when there's none

  club              Club                 @relation(fields: [clubId], references: [id])
  priceHistory      PlayerPriceHistory[]
  squadPlayers      SquadPlayer[]
  transfersOut      TransferHistory[]    @relation("TransferPlayerOut")
  transfersIn       TransferHistory[]    @relation("TransferPlayerIn")
  lineupPlanEntries LineupPlanPlayer[]
}

model PlayerPriceHistory {
  id         String   @id @default(cuid())
  playerId   Int
  price      Int
  recordedAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, recordedAt])
}

// A manager's squad as pulled from the FPL API at a given gameweek — a record
// of what actually happened, not a plan.
model SquadSnapshot {
  id         String   @id @default(cuid())
  fplTeamId  String
  gameweekId String
  bank       Int // in tenths of a million
  teamValue  Int // squad current-price value only, bank not included — see importer._replace_snapshot
  capturedAt DateTime @default(now())

  fplTeam  FplTeam       @relation(fields: [fplTeamId], references: [id], onDelete: Cascade)
  gameweek Gameweek      @relation(fields: [gameweekId], references: [id])
  players  SquadPlayer[]

  @@unique([fplTeamId, gameweekId])
}

model SquadPlayer {
  id            String  @id @default(cuid())
  snapshotId    String
  playerId      Int
  purchasePrice Int
  sellingPrice  Int
  isStarting    Boolean @default(false)
  squadPosition Int // 1-15, matching the FPL squad slot ordering
  isCaptain     Boolean @default(false)
  isViceCaptain Boolean @default(false)

  snapshot SquadSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  player   Player        @relation(fields: [playerId], references: [id])

  @@unique([snapshotId, playerId])
}

// Actual transfers as reported by the FPL API — separate from any
// in-progress planning data added in later build steps.
model TransferHistory {
  id           String   @id @default(cuid())
  fplTeamId    String
  gameweekId   String
  playerOutId  Int
  playerInId   Int
  transferCost Int // 0 or 4 (points), per the -4 hit rule
  executedAt   DateTime

  fplTeam   FplTeam  @relation(fields: [fplTeamId], references: [id], onDelete: Cascade)
  gameweek  Gameweek @relation(fields: [gameweekId], references: [id])
  playerOut Player   @relation("TransferPlayerOut", fields: [playerOutId], references: [id])
  playerIn  Player   @relation("TransferPlayerIn", fields: [playerInId], references: [id])

  @@index([fplTeamId, gameweekId])
}

// Which chip (if any) a manager actually played in a given gameweek, per
// the FPL API's own history endpoint. Only used so far to get the
// free-transfer rollover right — a Wildcard or Free Hit gameweek doesn't
// consume or roll the manager's saved free transfer at all, unlike a
// normal gameweek. Actually *using* a chip in this planner is a later
// build step (see CLAUDE.md); this only records real past usage.
model ChipUsage {
  id         String @id @default(cuid())
  fplTeamId  String
  gameweekId String
  chip       String // e.g. "wildcard", "free_hit", "bench_boost", "triple_captain"

  fplTeam  FplTeam  @relation(fields: [fplTeamId], references: [id], onDelete: Cascade)
  gameweek Gameweek @relation(fields: [gameweekId], references: [id])

  @@unique([fplTeamId, gameweekId])
}

// A hypothetical future lineup the user is planning — who starts, who's
// benched, who captains — using the 15 players already in their squad.
// Deliberately separate from SquadSnapshot: this is a plan, not a record of
// what actually happened.
model LineupPlan {
  id            String   @id @default(cuid())
  fplTeamId     String
  gameweekId    String
  // Transfer bookkeeping — set at save time. transfersMade/transferCost are
  // 0 for a plan that only reorders the existing 15 (no transfers). bank
  // cascades the same way LineupPlanPlayer's purchase/selling price does:
  // it's the resulting bank after this plan's transfers, read by later
  // gameweeks' budget checks instead of the real (current-gameweek-only)
  // SquadSnapshot.bank.
  transfersMade Int      @default(0)
  transferCost  Int      @default(0) // points lost to the -4-per-transfer hit
  // The chip activated for this specific gameweek's plan, if any — e.g.
  // "wildcard", "free_hit", "bench_boost", "triple_captain". Null for a
  // gameweek with no chip planned. Wildcard/Free Hit relax the "transfers
  // must replace a player with one of the same position" rule and skip the
  // -4 hit entirely for this plan; Free Hit's squad also doesn't carry
  // forward as the baseline for the next gameweek (see _find_prior_plan).
  chipUsed      String?
  bank          Int      @default(0)
  // Squad current-price value only — bank is cash, tracked separately, not
  // part of this. Cascades the same way bank does: a transfer removes the
  // outgoing player's current price and adds the incoming player's.
  teamValue     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fplTeam  FplTeam            @relation(fields: [fplTeamId], references: [id], onDelete: Cascade)
  gameweek Gameweek           @relation(fields: [gameweekId], references: [id])
  players  LineupPlanPlayer[]

  @@unique([fplTeamId, gameweekId])
}

model LineupPlanPlayer {
  id            String  @id @default(cuid())
  planId        String
  playerId      Int
  isStarting    Boolean @default(false)
  squadPosition Int
  isCaptain     Boolean @default(false)
  isViceCaptain Boolean @default(false)
  // Cost basis for this player within this plan — carried over unchanged
  // from the prior effective plan (with sellingPrice recomputed against
  // today's price) for players who weren't transferred, or set to today's
  // currentPrice for a player just transferred in. Mirrors SquadPlayer.
  purchasePrice Int     @default(0)
  sellingPrice  Int     @default(0)

  plan   LineupPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  player Player     @relation(fields: [playerId], references: [id])

  @@unique([planId, playerId])
}
