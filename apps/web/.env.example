# Copy to .env.local and fill in real values. Never commit .env.local.

DATABASE_URL="postgres://postgres:postgres@localhost:5432/fpl_planner?sslmode=disable"
AUTH_SECRET="" # generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple Developer -> Certificates, Identifiers & Profiles -> Services ID (this is AUTH_APPLE_ID)
# AUTH_APPLE_SECRET is a JWT you generate from a Sign in with Apple private key (.p8), Team ID, and Key ID.
# `npx auth add apple` (from apps/web) can walk through generating it.
# Apple does not support http://localhost callbacks at all — this provider can only be tested on a live https:// deployment.
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""
